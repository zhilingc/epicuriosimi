# track only the site files and precompute/
# (everything else at root — docs, data/, vocab.json, scratch — stays local)
/*
!/.gitignore
!/.github/
!/index.html
!/style.css
!/app.js
!/lib/
!/precompute/

# generated / local artifacts within tracked folders
__pycache__/
.pytest_cache/
precompute/.venv/
precompute/.model_cache/
